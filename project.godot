; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Frycz the Game 0.0.3"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TransitionManager="*res://scripts/transition_manager.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
InventoryManager="*res://scripts/inventory_manager.gd"
InventoryUI="*res://scripts/inventory_ui.gd"
GameSettings="*res://scripts/game_settings.gd"
PauseMenu="*res://scripts/pause_menu.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[editor]

movie_writer/fps=144

[editor_plugins]

enabled=PackedStringArray("res://addons/GitGodot/plugin.cfg")

[global_group]

Player=""

